{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"allowJs": true
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
	"exclude": ["node_modules"]
}
